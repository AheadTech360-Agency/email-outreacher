# Copy to .env.local for local development. On Vercel, set these as environment variables instead.

# Server-only (never sent to the browser) ---------------------------------------------------------
# The backend (FastAPI). The browser never calls it directly: app/api/v1 forwards every call.
BACKEND_URL=http://localhost:8000
# The same value as the backend's API_SECRET. Never prefix it with NEXT_PUBLIC_.
API_SECRET=
# Every address this app may be served at, comma-separated (local dev, the production domain, and any
# preview URL you use). Requests to any other address are refused.
AUTHORIZED_URLS=http://localhost:3000

# Public (sent to the browser) ------------------------------------------------------------------------
# Supabase, for signing in: the project URL and its publishable (anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The sending dashboard is this same app on a second address (app/config; proxy.ts picks the site by address).
# Server-only: the dashboard's host(s), comma-separated, like "config.xxx.com". Unset: any host starting "config.".
# Add its full address to AUTHORIZED_URLS above and to the backend's AUTHORIZED_URLS too.
CONFIG_HOSTS=
# Public: the dashboard's address for the sidebar's "Sending dashboard" link (unset: /config on this address),
# and Coldbrew's address for the dashboard's "Back to Coldbrew" link.
NEXT_PUBLIC_CONFIG_URL=
NEXT_PUBLIC_APP_URL=